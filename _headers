# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

# JSON data — short cache (admin updates propagate quickly)
/articles.json
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *

# Sitemap — 1 hour cache
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

# robots.txt — 1 hour cache
/robots.txt
  Cache-Control: public, max-age=3600

# HTML pages — short cache so updates propagate quickly
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Static assets (JS/CSS) — long cache
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Security headers (everything)
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
